{
  "name": "@kodall/kodall-deploy",
  "version": "1.2.0",
  "description": "CLI tool and library to deploy web applications to Kodall instances",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "kodall-deploy": "./dist/cli.js",
    "one-deploy": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "kodall",
    "deploy",
    "cli",
    "web-app"
  ],
  "author": "Kodall",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodall-app/kodall-deploy.git"
  },
  "bugs": {
    "url": "https://github.com/kodall-app/kodall-deploy/issues"
  },
  "homepage": "https://github.com/kodall-app/kodall-deploy#readme",
  "dependencies": {
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
